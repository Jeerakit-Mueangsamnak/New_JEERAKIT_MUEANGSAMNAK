{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Worker name. Must match the Worker/project name on Cloudflare (jjk-jeerakit-ttb).
  "name": "jjk-jeerakit-ttb",
  "account_id": "eb61cafefe4deeb21bcd69e361e05d43",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext calls back into this same Worker, so the service must be the Worker's own name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jjk-jeerakit-ttb"
    }
  ],
  // Worker Previews (Cloudflare Builds preview builds) do NOT inherit the top-level
  // `services` binding; it must be re-declared here or `env.WORKER_SELF_REFERENCE`
  // is undefined at runtime. Required because the preview deploy command is
  // `npx wrangler preview`. Note: a preview's service binding calls the PRODUCTION
  // deployment of the target Worker.
  "previews": {
    "services": [
      {
        "binding": "WORKER_SELF_REFERENCE",
        "service": "jjk-jeerakit-ttb"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
