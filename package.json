{
  "name": "rental-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:https": "next dev -H 0.0.0.0 --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "quality": "pnpm typecheck && pnpm typecheck:strict && pnpm lint",
    "verify": "pnpm run check:type && pnpm run test:run && pnpm run check:lint && pnpm run check:build",
    "workspace:setup": "pnpm install --frozen-lockfile",
    "dev:local": "next dev -H 127.0.0.1 -p 3000",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "check:type": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:build": "next build",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "baseline": "pnpm run check:type && pnpm run test:run",
    "check:code": "pnpm run check:type && pnpm run test:run && pnpm run check:lint",
    "clean:next": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "clean:cache": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true}); require('fs').rmSync('coverage',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "6.1.15",
    "@fullcalendar/timegrid": "^6.1.21",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@types/qrcode": "^1.5.6",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "next": "15.5.24",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^8",
    "eslint-config-next": "15.5.24",
    "jsdom": "^30.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
