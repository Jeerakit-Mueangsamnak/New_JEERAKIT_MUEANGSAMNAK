NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Legacy alternative to the publishable key (used only if NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is empty)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# Public origin used in Supabase email links, e.g. https://pos.example.com (must be in Supabase Redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only after dashboard_today_appointment_assignees is applied to Supabase Cloud.
NEXT_PUBLIC_DASHBOARD_ASSIGNEES_RPC=false
