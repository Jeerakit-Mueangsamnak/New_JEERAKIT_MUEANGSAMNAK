NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Legacy alternative to the publishable key (used only if NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is empty)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# Public origin used in Supabase email links, e.g. https://pos.example.com (must be in Supabase Redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only after dashboard_today_appointment_assignees is applied to Supabase Cloud.
NEXT_PUBLIC_DASHBOARD_ASSIGNEES_RPC=false
# ── SonarQube (ใช้กับ SonarQube MCP Server ใน .vscode/mcp.json) ───────────────
# Cloud: SONARQUBE_TOKEN จาก My Account > Security, SONARQUBE_ORG = organization key
# Server: SONARQUBE_TOKEN (user token) + SONARQUBE_URL (เช่น https://sonarqube.example.com)
SONARQUBE_TOKEN=
SONARQUBE_ORG=
SONARQUBE_PROJECT_KEY=

# ── LINE (server only unless NEXT_PUBLIC_) ───────────────────────────────────
# mock = queue only, nothing reaches LINE; live = push through the Messaging API
LINE_DELIVERY_MODE=mock
# Bearer secret (32+ characters) for /api/line/cron and /api/line/outbox (scheduler)
LINE_OUTBOX_CRON_SECRET=
# LINE Login channel id (same provider as the Messaging API channel) for LIFF ID token checks
LINE_LOGIN_CHANNEL_ID=
# LIFF app id (endpoint URL = https://<shop domain>/line/bind)
NEXT_PUBLIC_LIFF_ID=

# ── Sentry (error alerts in production; off when DSN is empty) ───────────────
# DSN from sentry.io > Project Settings > Client Keys. Safe to be public.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Optional: upload source maps at build time for readable stack traces (server/CI only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── ID card OCR (server only; never prefix with NEXT_PUBLIC_) ───────────────
# Free key from https://ocr.space/ocrapi/freekey (25,000 requests a month, Thai via Engine 2)
OCRSPACE_API_KEY=
# Optional: a lower monthly cap than the free 25,000
OCRSPACE_MONTHLY_LIMIT=
